{
  "realm": "financial-realm",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "loan-applicant",
        "description": "User permitted to apply for loans"
      },
      {
        "name": "loan-manager",
        "description": "User permitted to review and manage loan applications"
      }
    ]
  },
  "clients": [
    {
      "clientId": "loan-service",
      "name": "Loan Origination Service",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*",
        "*"
      ],
      "webOrigins": [
        "*"
      ]
    }
  ],
  "users": [
    {
      "username": "john_doe",
      "enabled": true,
      "email": "john.doe@example.com",
      "firstName": "John",
      "lastName": "Doe",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "loan-applicant"
      ]
    },
    {
      "username": "manager_jane",
      "enabled": true,
      "email": "jane.manager@example.com",
      "firstName": "Jane",
      "lastName": "Manager",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "loan-manager"
      ]
    }
  ]
}
